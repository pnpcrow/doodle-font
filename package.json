{
  "name": "doodle-font",
  "productName": "Doodle Font",
  "version": "0.1.0",
  "private": true,
  "description": "두들 폰트 — 나만의 글자를 그리는 폰트 작업실",
  "author": "Doodle Font",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "tsc -b && vite build",
    "test": "vitest run && python -m unittest discover -s tests -v",
    "test:e2e": "node tests/desktop.cjs",
    "package:service": "python -m PyInstaller --noconfirm --clean --onedir --name doodle-service --distpath build/service --workpath build/pyinstaller backend/server.py",
    "package": "npm run build && npm run package:service && electron-builder --win portable --x64"
  },
  "dependencies": {"react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0"},
  "devDependencies": {"@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.0.0", "typescript": "^5.9.0", "vite": "^7.1.0", "vitest": "^3.2.0", "electron": "^41.0.0", "electron-builder": "^26.0.0", "playwright": "^1.56.0"},
  "build": {
    "appId": "studio.doodlefont.desktop",
    "productName": "Doodle Font",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [{"from": "build/service/doodle-service", "to": "service"}],
    "win": {"target": "portable", "signAndEditExecutable": false},
    "portable": {"artifactName": "Doodle-Font-${version}-Windows.exe"}
  }
}
